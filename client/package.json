{
  "name": "scc-inspector-vscode",
  "displayName": "SCC Inspector",
  "description": "Analyze and debug SCC (Scenarist Closed Caption) files",
  "version": "0.1.0",
  "publisher": "scc-tools",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": ["onLanguage:scc"],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "scc",
        "aliases": ["SCC", "Scenarist Closed Caption"],
        "extensions": [".scc"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "scc",
        "scopeName": "source.scc",
        "path": "./scc.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "SCC Inspector",
      "properties": {
        "sccInspector.hoverEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable hover tooltips for SCC codes"
        },
        "sccInspector.decorationsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline decorations and error highlighting"
        },
        "sccInspector.annotationsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable decoded caption annotations"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm --prefix .. run compile",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "test": "echo \"No tests yet\""
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "scc-language-server": "*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "license": "MIT"
}