{
  "name": "scc-inspector-vscode",
  "displayName": "SCC Inspector",
  "description": "Analyze and debug SCC (Scenarist Closed Caption) files",
  "version": "1.0.1",
  "publisher": "DaveKneeland",
  "icon": "icon.png",
  "preview": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/dkneeland/scc-inspector"
  },
  "keywords": [
    "scc",
    "closed caption",
    "eia-608",
    "line 21",
    "subtitle",
    "caption",
    "scenarist"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": ["onLanguage:scc"],
  "main": "./dist/extension.js",
  "contributes": {
    "colors": [
      {
        "id": "sccInspector.problemLineBackground",
        "description": "Background color for lines with SCC problems",
        "defaults": {
          "dark": "#ff000015",
          "light": "#ff000010",
          "highContrast": "#ff000030"
        }
      }
    ],
    "languages": [
      {
        "id": "scc",
        "aliases": ["SCC", "Scenarist Closed Caption"],
        "extensions": [".scc"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "scc-buffer",
        "aliases": []
      }
    ],
    "grammars": [
      {
        "language": "scc",
        "scopeName": "source.scc",
        "path": "./scc.tmLanguage.json"
      },
      {
        "language": "scc-buffer",
        "scopeName": "source.scc-buffer",
        "path": "./scc-buffer.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "SCC Inspector",
      "properties": {
        "sccInspector.hoverEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable hover tooltips for SCC codes"
        },
        "sccInspector.decorationsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline decorations and error highlighting"
        },
        "sccInspector.frameRateOverride": {
          "type": "string",
          "enum": ["auto", "23.98", "25", "29.97 DF", "29.97 NDF"],
          "default": "auto",
          "description": "Override the auto-detected frame rate"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm --prefix .. run compile",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "test": "echo \"No tests yet\""
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "license": "MIT"
}